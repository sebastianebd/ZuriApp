ger[data-v-f5731108] {\r\n  color: #e74c3c;\r\n  font-size: 0.85rem;\r\n  font-weight: 500;\r\n  text-align: center;\n}\r\n\r\n/* --- Layout Principal --- */\n.login-wrapper[data-v-f5731108] {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  min-height: 100vh;\r\n  background-color: #f1f5f9; /* Slate 100 */\n}\n.login-box[data-v-f5731108] {\r\n  width: 100%;\r\n  max-width: 1100px;\r\n  min-height: 650px;\r\n  border-radius: 24px;\r\n  overflow: hidden;\r\n  background: #fff;\r\n  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);\r\n  margin: 20px;\n}\r\n\r\n/* --- Formulario --- */\n.login-form[data-v-f5731108] {\r\n  padding: 4rem;\r\n  position: relative;\r\n  background: #fff;\n}\n.form-content[data-v-f5731108] {\r\n  width: 100%;\r\n  max-width: 400px;\r\n  margin: 0 auto;\n}\r\n\r\n/* Inputs Premium */\n.input-wrapper label[data-v-f5731108] {\r\n  font-size: 0.9rem;\r\n  font-weight: 600;\r\n  color: #64748b; /* Slate 500 */\r\n  margin-bottom: 0.5rem;\r\n  display: block;\n}\n.input-group-custom[data-v-f5731108] {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\n}\n.input-icon[data-v-f5731108] {\r\n  position: absolute;\r\n  left: 16px;\r\n  color: #94a3b8;\r\n  font-size: 1.2rem;\r\n  transition: color 0.3s;\r\n  z-index: 2;\n}\n.form-control-custom[data-v-f5731108] {\r\n  width: 100%;\r\n  padding: 14px 16px 14px 48px; /* Espacio para icono */\r\n  border: 2px solid #e2e8f0;\r\n  border-radius: 12px;\r\n  font-size: 1rem;\r\n  color: #1e293b;\r\n  background: #f8fafc;\r\n  outline: none;\r\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.form-control-custom[data-v-f5731108]:focus {\r\n  background: #fff;\r\n  border-color: #3b82f6; /* Blue 500 */\r\n  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);\n}\n.form-control-custom:focus + .input-icon[data-v-f5731108],\r\n.input-group-custom:focus-within .input-icon[data-v-f5731108] {\r\n  color: #3b82f6;\n}\r\n\r\n/* Update placeholder color */\n.form-control-custom[data-v-f5731108]::placeholder {\r\n  color: #cbd5e1;\n}\r\n\r\n/* Botón Premium */\n.custom-btn[data-v-f5731108] {\r\n  width: 100%;\r\n  padding: 16px;\r\n  border-radius: 14px;\r\n  border: none;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);\r\n  color: white;\r\n  font-size: 1.1rem;\r\n  font-weight: 600;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.3);\n}\n.custom-btn[data-v-f5731108]:hover:not(:disabled) {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.4);\r\n  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);\n}\n.custom-btn[data-v-f5731108]:disabled {\r\n  opacity: 0.7;\r\n  cursor: not-allowed;\n}\r\n\r\n/* --- Banner Derecho --- */\n.login-banner[data-v-f5731108] {\r\n  position: relative;\r\n  background-image: url('/src/assets/images/banner.jpg');\r\n  background-size: cover;\r\n  background-position: center;\n}\r\n\r\n/* Overlay Glass Effect */\n.login-banner .overlay[data-v-f5731108] {\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(135deg, rgba(59, 130, 246, 0.9) 0%, rgba(37, 99, 235, 0.85) 100%);\r\n  backdrop-filter: blur(2px);\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  padding: 4rem;\r\n  color: white;\n}\n.login-banner h2[data-v-f5731108] {\r\n  font-size: 2.5rem;\r\n  font-weight: 800;\r\n  line-height: 1.2;\n}\n.login-banner span[data-v-f5731108] {\r\n  color: #fff;\r\n  text-decoration: underline;\r\n  text-decoration-color: rgba(255, 255, 255, 0.3);\r\n  text-underline-offset: 8px;\n}\n.login-banner p[data-v-f5731108] {\r\n  font-size: 1.25rem;\r\n  opacity: 0.9;\r\n  margin-top: 1rem;\r\n  font-weight: 400;\n}\r\n\r\n/* Logo Flotante */\n.logo-container[data-v-f5731108] {\r\n  position: absolute;\r\n  top: 30px;\r\n  left: 40px;\n}\n.app-logo[data-v-f5731108] {\r\n  height: 90px;\n}\r\n\r\n/* --- Mobile Responsiveness (Top App Design) --- */\n@media (max-width: 768px) {\n.login-wrapper[data-v-f5731108] {\r\n    align-items: flex-start;\r\n    background: #fff;\r\n    height: 100vh;\r\n    padding: 0 !important; /* Fix: Eliminar padding de container-fluid */\n}\n.login-box[data-v-f5731108] {\r\n    margin: 0;\r\n    max-width: none;\r\n    border-radius: 0;\r\n    box-shadow: none;\r\n    height: 100%;\r\n    flex-direction: column;\r\n    --bs-gutter-x: 0; /* Fix: Eliminar gutters de la fila */\n}\r\n\r\n  /* 1. Imagen Superior (Hero) */\n.login-banner[data-v-f5731108] {\r\n    order: -1;\r\n    height: 42vh; /* Altura generosa */\r\n    min-height: 300px;\n}\n.login-banner .overlay[data-v-f5731108] {\r\n    padding: 2rem;\r\n    align-items: center;\r\n    justify-content: center;\r\n    text-align: center;\r\n    background: linear-gradient(to bottom, rgba(59, 130, 246, 0.6), rgba(30, 41, 59, 0.8));\n}\n.login-banner h2[data-v-f5731108] {\r\n    font-size: 2rem;\r\n    margin-bottom: 3rem; /* Espacio para que no lo tape la tarjeta */\r\n    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);\n}\n.login-banner p[data-v-f5731108] {\r\n    display: none;\n}\r\n\r\n  /* 2. Tarjeta Deslizable (\"Bottom Sheet\") */\n.login-form[data-v-f5731108] {\r\n    flex: 1;\r\n    margin-top: -50px; /* Overlap mágico */\r\n    border-radius: 40px 40px 0 0;\r\n    z-index: 10;\r\n    padding: 3rem 1.5rem;\r\n    background: #fff;\r\n    box-shadow: 0 -10px 25px rgba(0, 0, 0, 0.05);\n}\n.form-content[data-v-f5731108] {\r\n    margin-top: 0;\n}\r\n\r\n  /* Ajustes Visuales Móvil */\n.logo-container[data-v-f5731108] {\r\n    display: none;\n}\n.input-wrapper label[data-v-f5731108] {\r\n    margin-left: 0.5rem;\n}\n}\r\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"app","data-v-app":""},["DIV",{"id":"app"},["DIV",{"data-v-efee688e":"","class":"auth-layout"},["DIV",{"data-v-f5731108":"","data-v-efee688e":"","class":"login-wrapper container-flui