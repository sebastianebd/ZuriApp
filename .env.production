# --- VARIABLES DE PRODUCCIÓN (Plantilla) ---
# Copia esto en Railway variables

NODE_ENV=production
PORT=3500

# MongoDB Atlas
DATABASE_URI=

# JWT Secrets (Generar aleatorios seguros)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Sentry
SENTRY_DSN=

# URLs
# En Railway, CLIENT_URL es la URL de tu frontend deployado
CLIENT_URL=https://tu-app-frontend.up.railway.app
VITE_API_URL=https://tu-app-backend.up.railway.app

# Client Sentry
VITE_SENTRY_DSN=
