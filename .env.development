# --- CONFIGURACIÓN DE DESARROLLO LOCAL (DOCKER) ---

# Servidor
NODE_ENV=development
PORT=3500

# Base de datos: "mongo" es el nombre del servicio en docker-compose.yml
DATABASE_URI=mongodb://mongo:27017/zuri_db

# Secretos (EN DESARROLLO PUEDEN SER CUALQUIER COSA, PERO EN PROD DEBEN SER SEGUROS Y DISTINTOS)
# NOTA: Cambia estos valores en tu archivo .env real si quieres más seguridad local,
# pero para desarrollo genérico estos defaults funcionan.
ACCESS_TOKEN_SECRET=secreto_dummy_para_desarrollo_123
REFRESH_TOKEN_SECRET=secreto_dummy_para_desarrollo_456

# Sentry (Observabilidad)
SENTRY_DSN=https://tu_clave_publica@o0.ingest.sentry.io/id_de_proyecto

# URLs
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3500
# Vite Proxy para Docker
VITE_PROXY_TARGET=http://server:3500

# Client Sentry
VITE_SENTRY_DSN=https://tu_clave_publica@o0.ingest.sentry.io/id_de_proyecto
